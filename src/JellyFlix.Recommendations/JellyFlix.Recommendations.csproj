<Project Sdk="Microsoft.NET.Sdk">

  <!-- JellyFlix recommendations plugin. Built against the in-tree server projects and deployed as a regular Jellyfin plugin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- The server already ships every referenced assembly (including transitive ones), so none may be copied into the plugin folder. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JellyFlix.Recommendations.Tests" />
  </ItemGroup>

</Project>
